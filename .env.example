# Copy this file to .env on the server (never commit .env)

PORT=4000
HOST=127.0.0.1

# Cookie is shared by omranisystems.com and every subdomain
COOKIE_DOMAIN=.omranisystems.com

# How long an unlocked app stays unlocked (hours)
UNLOCK_HOURS=12

# Long random secret used to sign the unlock cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
GATE_SECRET=change-me

# One line per app id from apps.json: CODE_<ID>=<hash>
# Generate each hash with:  npm run hash -- 123456
CODE_PASS=
CODE_CHAT=
CODE_AI=
CODE_IT=
CODE_GYM=
